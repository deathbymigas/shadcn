{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/**/*.md"],
  "formatter": true,
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "tsc *": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "ask",
    "task": "allow",
    "skill": "allow",
    "question": "allow",
    "doom_loop": "ask"
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "git push *": "ask",
          "pnpm build": "allow"
        }
      }
    }
  }
}
